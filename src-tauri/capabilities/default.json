{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Basic permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$TEMP/openexplainer-pdf" }, { "path": "$TEMP/openexplainer-pdf/**" }]
    }
  ]
}
