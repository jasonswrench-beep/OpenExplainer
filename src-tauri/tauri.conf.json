{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenExplainer",
  "version": "0.2.0",
  "identifier": "org.openexplainer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://huggingface.co https://*.hf.co http://127.0.0.1:*" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "runtime/llama/*": "llama/",
      "../capture-helper/target/release/openexplainer-capture.exe": "openexplainer-capture.exe",
      "../LICENSE": "LICENSE.txt",
      "../NOTICE": "NOTICE.txt"
    },
    "fileAssociations": [
      { "ext": ["openexplainer"], "name": "OpenExplainer project", "description": "An OpenExplainer project: a book or tutorial made from screen captures", "role": "Editor" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico" }
    }
  }
}
